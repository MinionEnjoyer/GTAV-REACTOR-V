<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RageWebUI.Runtime</AssemblyName>
    <RootNamespace>RageWebUI.Runtime</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactorV.Core\RageWebUI.Core.csproj" />
    <ProjectReference Include="..\ReactorV.DirectX\RageWebUI.DirectX.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\OverlayPresentationPolicy.cs" Link="OverlayPresentationPolicy.cs" />
    <Compile Include="..\Shared\WebView2EnvironmentFactory.cs" Link="WebView2EnvironmentFactory.cs" />
    <Compile Include="..\Shared\WebView2LocalPagePolicy.cs" Link="WebView2LocalPagePolicy.cs" />
    <Compile Include="..\Shared\WebView2LocalPage.cs" Link="WebView2LocalPage.cs" />
    <Compile Include="..\Shared\WebView2ReadinessPolicy.cs" Link="WebView2ReadinessPolicy.cs" />
    <Compile Include="..\Shared\WebView2PageReadiness.cs" Link="WebView2PageReadiness.cs" />
  </ItemGroup>
</Project>
